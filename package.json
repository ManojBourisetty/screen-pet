{
  "name": "screen-pet",
  "version": "0.1.0",
  "description": "A fluffy puppy that lives on your desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/renderer/app.js --bundle --outfile=src/renderer/dist/bundle.js --format=iife --platform=browser",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.manojbourisetty.screenpet",
    "productName": "Screen Pet",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": "dmg"
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
